# Copiá este archivo como ".env" y poné tu clave.
# La clave se saca gratis en https://aistudio.google.com/apikey
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
GEMINI_API_KEY=tu_clave_aca
# Notion (para los hábitos): notion.so/profile/integrations -> nueva integración
NOTION_TOKEN=tu_token_de_notion
